---
import ItemRow from './ItemRow.astro';
import FilterBar from './FilterBar.astro';
import type { Item } from '../lib/queries.ts';
import { activeSourceIds, lastRefresh } from '../lib/queries.ts';
import type { Topic } from '../lib/topics.ts';
import { CATEGORIES, SOURCES, SOURCE_BY_ID, paths, type Category } from '../lib/sources.ts';
import { MAX_PAGES, PAGE_SIZE, groupByDay, hostname, pageSlice, shortDateTime } from '../lib/format.ts';

interface Props {
  items: Item[];
  page?: number;
  category?: Category;
  sourceId?: string;
  topic?: Topic;
}

const { items, page = 1, category, sourceId, topic } = Astro.props;
const source = sourceId ? SOURCE_BY_ID.get(sourceId) : undefined;
const pageCount = sourceId ? 1 : Math.min(MAX_PAGES, Math.ceil(items.length / PAGE_SIZE));
const shown = sourceId ? items : pageSlice(items, page);
const groups = groupByDay(shown);
const pageHref = (n: number) =>
  topic ? paths.topic(topic.slug, n) : category ? paths.category(category, n) : paths.home(n);

const heading = source?.name ?? topic?.label ?? (category ? CATEGORIES[category].label : 'Latest');
const blurb = source ? '' : (topic?.blurb ?? (category ? CATEGORIES[category].blurb : 'Everything from every source, newest first.'));

// Sidebar: the sources behind this listing, minus any that have been quiet for 90 days.
const active = activeSourceIds();
const sidebarCategory = category ?? source?.category;
const topicSourceIds = topic ? new Set(items.map((i) => i.source.id)) : undefined;
const sidebarSources = SOURCES.filter(
  (s) =>
    (active.has(s.id) || s.id === sourceId) &&
    (topicSourceIds ? topicSourceIds.has(s.id) : !sidebarCategory || s.category === sidebarCategory),
);
const sidebarLabel = topic?.label ?? (sidebarCategory ? CATEGORIES[sidebarCategory].label : 'All');
const refreshed = lastRefresh();
// Topic chips apply to the full river and sections; source and topic pages are already narrow.
const filterable = !sourceId && !topic;
---

<div class="layout">
  <section class="river" aria-labelledby="river-heading" data-filterable={filterable ? '' : undefined} data-category={category}>
    <div class="river-head">
      <h1 id="river-heading">{heading}</h1>
      {source ? (
        <p class="blurb">
          <a href={source.site} target="_blank" rel="noopener">{hostname(source.site)}</a> ·
          <a href={paths.category(source.category)}>{CATEGORIES[source.category].label}</a> ·
          <a href={source.feed} target="_blank" rel="noopener">{source.format ? 'Source query (API)' : 'Original feed'}</a>
        </p>
      ) : (
        <p class="blurb">{blurb}</p>
      )}
      {filterable && <FilterBar />}
    </div>
    {filterable && (
      <Fragment>
        <p class="filter-status blurb" aria-live="polite" hidden></p>
        <div class="river-filtered" hidden></div>
      </Fragment>
    )}
    <div class="river-static">
    {groups.length ? (
      groups.map((g) => (
        <Fragment>
          <h2 class="day" data-day={g.key}>{g.label}</h2>
          <ol class="items">
            {g.items.map((item) => <ItemRow item={item} showCategory={!category && !sourceId} />)}
          </ol>
        </Fragment>
      ))
    ) : (
      <p class="empty">Nothing here yet. Feeds refresh daily.</p>
    )}
    {pageCount > 1 && (
      <nav class="pager" aria-label="Pagination">
        {page > 1 ? <a href={pageHref(page - 1)}>← Newer</a> : <span />}
        {page < pageCount && <a href={pageHref(page + 1)}>Older →</a>}
      </nav>
    )}
    </div>
  </section>
  <aside class="sidebar" aria-label="Sources">
    <h2>{sidebarLabel} sources</h2>
    <ul class="source-list">
      {sidebarSources.map((s) => (
        <li><a href={paths.source(s.id)} class:list={{ 'is-active': s.id === sourceId }}>{s.name}</a></li>
      ))}
    </ul>
    {refreshed && (
      <p class="refreshed">Updated <time data-relative datetime={refreshed.toISOString()}>{shortDateTime(refreshed)}</time></p>
    )}
  </aside>
</div>
