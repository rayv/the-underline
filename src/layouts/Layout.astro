---
import '../styles/global.css';
import { CATEGORIES, CATEGORY_KEYS, SOURCES, paths, type Category } from '../lib/sources.ts';
import { SITE_DESCRIPTION, SITE_NAME, SITE_TZ } from '../lib/format.ts';

interface Props {
  title?: string;
  active?: Category | 'all' | 'sources' | 'search';
  feedHref?: string;
}

const { title, active = 'all', feedHref = '/rss.xml' } = Astro.props;
const searchCategory = active in CATEGORIES ? (active as Category) : undefined;
const tabs = [
  { key: 'all', href: paths.home(), label: 'All' },
  ...CATEGORY_KEYS.map((c) => ({ key: c, href: paths.category(c), label: CATEGORIES[c].label })),
  { key: 'sources', href: '/sources/', label: 'Sources' },
];
---

<!doctype html>
<html lang="en" data-tz={SITE_TZ}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${SITE_NAME}` : SITE_NAME}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={feedHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash of the wrong one.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28"><rect width="32" height="32" rx="7" fill="var(--text)"></rect><path d="M10.5 7.5v8a5.5 5.5 0 0 0 11 0v-8" fill="none" stroke="var(--bg)" stroke-width="3.2" stroke-linecap="round"></path><rect x="8" y="23.6" width="16" height="3.2" rx="1.6" fill="var(--highlighter)"></rect></svg>
          </span>
          <span class="brand-name">The <span class="brand-underline">Underline</span></span>
        </a>
        <form class="search" action="/search/" method="get" role="search">
          {searchCategory && <input type="hidden" name="category" value={searchCategory} />}
          <input type="search" name="q" id="search-input" placeholder="Search headlines…" aria-label="Search headlines" />
        </form>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
      </div>
      <nav class="wrap tabs" aria-label="Sections">
        {tabs.map((t) => (
          <a href={t.href} class:list={['tab', { 'is-active': active === t.key }]} aria-current={active === t.key ? 'page' : undefined}>{t.label}</a>
        ))}
      </nav>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="wrap footer">
      <p>{SITE_NAME} aggregates headlines from {SOURCES.length} publicly available feeds, refreshed daily. All content belongs to its publishers; every headline links to the original.</p>
      <p><a href={feedHref}>RSS</a> · <a href="/sources.opml">OPML</a> · <a href="/items.json">JSON</a> · <a href="/sources/">Sources</a></p>
    </footer>
    <script>
      import { initPage } from '../scripts/page.ts';
      initPage();
    </script>
  </body>
</html>
